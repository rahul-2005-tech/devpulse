# Environment variables for DevPulse backend
# Copy this file to .env and fill in values if needed.
# All variables have defaults; only set them to override.

# Server port (frontend will proxy to this in production, or call directly in dev)
PORT=3001

# Optional GitHub PAT to raise the unauthenticated rate limit (60/hr) to 5000/hr.
# Not required for the initial version.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Node environment
NODE_ENV=development
