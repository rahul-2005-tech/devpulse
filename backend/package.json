{
  "name": "devpulse-backend",
  "version": "1.0.0",
  "description": "DevPulse — GitHub Repository Intelligence Dashboard (backend)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "axios": "^1.7.9",
    "sql.js": "^1.11.0",
    "zod": "^3.24.1",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.1",
    "@types/cors": "^2.8.17",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
